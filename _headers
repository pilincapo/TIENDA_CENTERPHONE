# Cabeceras de seguridad para los assets estáticos (Workers Assets).
# Las rutas dinámicas del worker reciben las mismas cabeceras vía middleware
# (src/worker/security.ts). Sin nonce aquí: los HTML estáticos no tienen
# scripts inline (solo la página /seguimiento, que genera el worker con nonce).
# Panel: el HTML del login no se cachea en ningún proxy. Cada ruta va con su
# propio bloque de cabeceras: varias líneas de ruta seguidas de UNA cabecera
# dejaban a las dos primeras sin cabeceras (wrangler lo reportaba como «No
# headers specified»), así que /admin y /admin/index.html se cacheaban.
# Los bundles de Vite llevan hash en el nombre: cada cambio de contenido crea
# otra URL, por eso pueden permanecer un año en la caché del navegador.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/admin/index.html
  Cache-Control: no-store

/admin
  Cache-Control: no-store

/admin/
  Cache-Control: no-store

/*
  Content-Security-Policy: default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
