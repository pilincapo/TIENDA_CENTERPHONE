{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celu-store",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // El home (/) pasa primero por el worker: necesario para el redirect 301 de
    // www → dominio sin www. /changelog.md también: es documentación interna y
    // solo se sirve autenticado vía /api/admin/changelog (el asset suelto queda
    // bloqueado). El resto de assets se sirve directo (más rápido).
    "run_worker_first": ["/", "/changelog.md"]
  },
  "triggers": {
    // Despierta cada 15 min; el worker decide si corresponde sincronizar
    // según el intervalo configurado en el panel de administración.
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "celu-store-db",
      "database_id": "b56c2cb6-5865-4c3f-98e0-192846a1576e"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "71875a431359487e954c86f15edf54ae"
    }
  ],
  // Cuenta de Cloudflare (no es secreto): la usa la pestaña Seguridad del panel
  // para leer los eventos de seguridad del worker vía API. El API token va
  // aparte como secret (CF_LOGS_TOKEN, con permiso de lectura de Workers Logs).
  "vars": {
    "CF_ACCOUNT_ID": "0bb717edbda5f33508dc01f1d194a00b",
    // Origen del sitio para back_urls de MercadoPago y purga de caché:
    // en producción apunta a centerphone.com.ar (el worker valida www → no-www).
    "CF_SITE_ORIGIN": "https://centerphone.com.ar"
  },
  // Workers Logs: guarda los console.* del worker (retención corta en el plan
  // gratis). Sin esto los eventos de seguridad no se capturan — los otros
  // workers del negocio (repairpro) ya lo tenían activo.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Envío de email (resumen semanal de seguridad, ver src/worker/digest.ts).
  // Restringido a una sola casilla: el worker no puede mandar a ninguna otra.
  // Requiere Email Routing activo en centerphone.com.ar (ya habilitado) y la
  // casilla verificada en la cuenta (ya verificado).
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "pilin123@gmail.com"
    }
  ]
}
